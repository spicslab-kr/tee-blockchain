dist/

# `go build ./cmd/<role>/...` without -o drops a binary named after the package into the repo root.
/auditor
/auditor.exe
/vendor
/vendor.exe
/user
/user.exe
/ra-responder
/ra-responder.exe
# e2e/0-Setup-local-upload.sh cross-builds the Linux binaries for the instances into the repo root.
/att-vendor
/att-auditor
/att-user
/att-ra-responder

# e2e scripts: files fetched from the instances during a run
e2e-work/

# `go generate` in internal/chain/register/*/ether runs `forge build` in contracts/evm: its compiler output
# (Registry.abi and Registry.bin, read by abigen) and forge's cache. Build products; the binding registry.go is committed.
/contracts/evm/out/
/contracts/evm/cache/

# docs/build/tdx.md and sev-snp.md, run from the repository root on your computer: the guest binaries (step 2) and the
# evidence, nonce and measurements fetched in steps 10-11
/linux/
/quote.bin*
/evidence.cbor*
/measurements.json
# ... and "The Auditor's half" (both docs): what the Vendor hands over, fetched to the repository root
/vendor-app/
/vendor-app-snp/
/vendor-base-initrd-v.img
/vendor-snp-base-initrd-v.img
/vendor-build-value*.json

# SSH private key — never commit
pem2.pem
*.pem
*.key
!internal/tee/parse/aws/root.pem
!internal/tee/parse/tdx/root.pem
!internal/tee/parse/snp/root.pem

